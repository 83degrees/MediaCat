  "config": {
    "alias": "AdvMedia - Fn: Media Profile Google Cast",
    "description": "Builds a Google Cast media payload from a media record.",
    "mode": "parallel",
    "max": 10,
    "fields": {
      "media_record": {
        "name": "Media Record",
        "description": "The resolved media record.",
        "required": true,
        "selector": {
          "object": {}
        }
      }
    },
    "sequence": [
      {
        "variables": {
          "payload_response": {
