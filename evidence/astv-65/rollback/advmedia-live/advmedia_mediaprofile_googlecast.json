                  {
                    "url": "{{\n  media_record.artwork.external\n  | default(media_record.artwork.local, true)\n}}\n"
                  }
                ]
              },
              "stream_type": "LIVE",
              "autoplay": true
            }
          }
        }
      },
      {
        "stop": "Payload built",
        "response_variable": "payload_response"
      }
    ]
  }
